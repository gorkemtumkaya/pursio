# Copy to .env and fill in real values. Never commit .env.
# Public (exposed to the client)
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (later)
NUXT_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NUXT_LLM_PROVIDER=anthropic
NUXT_LLM_MODEL=claude-sonnet-4-5
NUXT_LLM_API_KEY=your-llm-api-key
NUXT_YOUTUBE_API_KEY=your-youtube-api-key
NUXT_VIDEO_DAILY_QUOTA=10000
NUXT_VIDEO_DRAIN_SECRET=your-long-random-drain-secret