# Copy to .env and fill in real values. Never commit .env.
# Public (exposed to the client)
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NUXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token_here
NUXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host.example

# Server-only (later)
NUXT_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NUXT_LLM_PROVIDER=anthropic
NUXT_LLM_MODEL=claude-sonnet-4-5
NUXT_LLM_API_KEY=your-llm-api-key
NUXT_YOUTUBE_API_KEY=your-youtube-api-key
NUXT_VIDEO_DAILY_QUOTA=10000
NUXT_VIDEO_DRAIN_SECRET=your-long-random-drain-secret
NUXT_FRESH_CHECK_SECRET=your-long-random-fresh-check-secret

NUXT_LLM_INTAKE_MODEL_ANTHROPIC=claude-haiku-4-5

# Paddle.js on /pricing. Required, no default: "sandbox" or "production".
NUXT_PUBLIC_PADDLE_ENV=sandbox
# Client-side token: test_... for sandbox, live_... for production.
NUXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxx
# "true" lets Subscribe open Paddle Checkout. Anything else shows "Coming soon".
NUXT_PUBLIC_PADDLE_CHECKOUT_ENABLED=false

# Paddle server-side (never exposed to the browser).
# API key: pdl_sdbx_apikey_... for sandbox, pdl_live_apikey_... for production.
NUXT_PADDLE_API_KEY=pdl_sdbx_apikey_xxxxxxxx
# Signing secret of the notification destination (not the API key).
NUXT_PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxx